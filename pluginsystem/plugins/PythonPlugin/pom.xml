<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns="http://maven.apache.org/POM/4.0.0"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <artifactId>PythonPlugin</artifactId>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <configuration>
              <!-- keep a normal pom, avoid dependency-reduced pom issues -->
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <minimizeJar>false</minimizeJar>
              <!-- optional: relocate packages to avoid conflicts with host app -->
              <!--
              <relocations>
                <relocation>
                  <pattern>net.lingala.zip4j</pattern>
                  <shadedPattern>shaded.net.lingala.zip4j</shadedPattern>
                </relocation>
              </relocations>
              -->
            </configuration>
            <goals>
              <goal>shade</goal>
            </goals>
            <phase>package</phase>
          </execution>
        </executions>
        <groupId>org.apache.maven.plugins</groupId>
        <version>3.4.1</version>
      </plugin>
      <!-- The embedded Python environments (python-env/dist/{nix,win}_env.zip) are built outside
           Git (python-env/build-*.sh or CI artifacts). A missing zip is only a warning: the plugin
           still builds and starts, and reports "Python not available" at runtime. -->
      <plugin>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>warn-missing-python-env</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <phase>validate</phase>
            <configuration>
              <fail>false</fail>
              <rules>
                <requireFilesExist>
                  <files>
                    <file>${project.basedir}/python-env/dist/nix_env.zip</file>
                  </files>
                  <message>python-env/dist/nix_env.zip missing: the PythonPlugin JAR will contain no Linux Python environment (build it with python-env/build-linux.sh or fetch the CI artifact).</message>
                </requireFilesExist>
                <requireFilesExist>
                  <files>
                    <file>${project.basedir}/python-env/dist/win_env.zip</file>
                  </files>
                  <message>python-env/dist/win_env.zip missing: the PythonPlugin JAR will contain no Windows Python environment (fetch the CI artifact).</message>
                </requireFilesExist>
              </rules>
            </configuration>
          </execution>
        </executions>
        <groupId>org.apache.maven.plugins</groupId>
        <version>3.5.0</version>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- JEP loads libjep/libpython via JNI (JEP 472). -->
          <argLine>--enable-native-access=ALL-UNNAMED</argLine>
          <systemPropertyVariables>
            <ajan.python.cacheDir>${project.build.directory}/ajan-python-cache</ajan.python.cacheDir>
            <ajan.python.requireEnv>${ajan.python.requireEnv}</ajan.python.requireEnv>
          </systemPropertyVariables>
        </configuration>
        <groupId>org.apache.maven.plugins</groupId>
      </plugin>
      <plugin>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <configuration>
              <excludeArtifactIds>
                rdfbeans,
                gdx-ai,
                behaviour,
                loader,
                common,
                lombok,
                rdf4j-model,
                rdf4j-repository-api
              </excludeArtifactIds>
              <excludeTransitive>true</excludeTransitive>
              <outputDirectory>${project.build.directory}/lib</outputDirectory>
              <overWriteReleases>false</overWriteReleases>
              <overWriteSnapshots>true</overWriteSnapshots>
            </configuration>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <phase>install</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <includes>
          <include>**/*</include>
        </includes>
      </resource>
      <!-- Lands at the JAR root as /nix_env.zip and /win_env.zip (see PythonEnvironment). -->
      <resource>
        <directory>python-env/dist</directory>
        <includes>
          <include>nix_env.zip</include>
          <include>win_env.zip</include>
        </includes>
      </resource>
    </resources>
  </build>
  <dependencies>
    <dependency>
      <artifactId>zip4j</artifactId>
      <groupId>net.lingala.zip4j</groupId>
      <version>2.11.5</version>
    </dependency>
    <dependency>
      <artifactId>testng</artifactId>
      <groupId>org.testng</groupId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <modelVersion>4.0.0</modelVersion>

  <name>PythonPlugin</name>

  <packaging>jar</packaging>

  <parent>
    <artifactId>plugins</artifactId>
    <groupId>de.dfki.asr.ajan.pluginsystem</groupId>
    <version>0.1</version>
  </parent>

  <properties>
    <!-- true: PythonJepTest fails instead of skipping when no env zip for this OS is embedded. -->
    <ajan.python.requireEnv>false</ajan.python.requireEnv>
    <netbeans.hint.license>licenseheader</netbeans.hint.license>
    <plugin.class>de.dfki.asr.ajan.pluginsystem.pythonplugin.PythonPlugin</plugin.class>
    <plugin.dependencies/>
    <plugin.id>PythonPlugin</plugin.id>
    <plugin.provider>Andre Antakli</plugin.provider>
    <plugin.version>0.0.1</plugin.version>
  </properties>

  <repositories>
    <repository>
      <id>lib</id>
      <url>file:///${project.basedir}/lib</url>
    </repository>
  </repositories>
</project>