<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>spike</groupId>
    <artifactId>boot4-resteasy</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <!-- Spike B result (VERIFIED by actually running it, see task-10-12-report.md):
             GREEN. resteasy-servlet-spring-boot-starter:6.3.0.Final DOES work on Boot 4.1.0
             with JDK 21, once two brief-template issues are corrected:
             1) brief's pom.xml used groupId org.jboss.resteasy.spring.boot, which does not
                exist on Maven Central (resolution fails: "Could not find artifact ... in
                central"). Real coordinate is groupId org.jboss.resteasy.
             2) the starter alone declares zero transitive dependencies (verified via
                dependency:tree) - it needs an explicit servlet-container starter added by
                the app, exactly like on Boot 3.x. Without spring-boot-starter-web the app
                fails with NoClassDefFoundError: jakarta/servlet/ServletContextListener.
             With both fixes: app starts, JaxrsConfig/HelloResource (JAX-RS annotations) are
             deployed by RESTEasy, GET http://localhost:18080/api/hello -> 200 "hello".
             One benign WARN remains: "Failed to introspect meta-annotation @AutoConfiguration
             on class org.jboss.resteasy.springboot.ResteasyAutoConfiguration:
             java.lang.TypeNotPresentException: Type ...WebMvcAutoConfiguration not present"
             - does not stop startup or break the endpoint. -->
        <dependency>
            <groupId>org.jboss.resteasy</groupId>
            <artifactId>resteasy-servlet-spring-boot-starter</artifactId>
            <version>6.3.0.Final</version>
        </dependency>
        <!-- Spike C result (VERIFIED by actually running it): RED - staying on Tomcat.
             Step 1 as literally written in the brief (exclude spring-boot-starter-tomcat from
             spring-boot-starter-web + add spring-boot-starter-undertow with no explicit
             version, relying on the Boot BOM to manage it) fails at the POM-validation stage:
             "'dependencies.dependency.version' for org.springframework.boot:
             spring-boot-starter-undertow:jar is missing" - spring-boot-dependencies:4.1.0 does
             not manage this artifact at all, i.e. Boot no longer ships a managed Undertow
             starter version in the 4.x line.
             Follow-up attempt (not in brief, done to see how far this goes): explicitly pinning
             <version>4.0.0-M1</version> (the only Boot-4-line release that exists on Maven
             Central for this artifact) resolves and compiles, but fails at startup with:
             "An attempt was made to call a method that does not exist... The following method
             did not exist: 'PropertyMapper PropertyMapper.alwaysApplyingWhenNonNull()'" thrown
             from org.springframework.boot.undertow.autoconfigure.UndertowWebServerFactoryCustomizer
             (compiled against the 4.0.0-M1 milestone's spring-boot-context API) when loaded
             against spring-boot:4.1.0 on the classpath - i.e. even the abandoned milestone
             artifact is binary-incompatible with the 4.1.0 GA core APIs that shipped since.
             Reverted to the default Tomcat starter pulled in transitively by
             spring-boot-starter-web (no exclusion, no undertow dependency) - the state
             verified to work in Spike B. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
    </dependencies>

</project>
