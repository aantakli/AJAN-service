<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>de.dfki.asr.ajan.spikes</groupId>
  <artifactId>rdf4j5-boot13</artifactId>
  <version>0.1</version>
  <packaging>jar</packaging>
  <!-- Wegwerf-Gate (s. spikes/README.md): beantwortet offene Frage 4 der
       Spike-Ergebnisse. Bewusst mit demselben Parent wie executionservice,
       damit das Boot-1.3-dependencyManagement wirksam wird. -->

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>1.3.5.RELEASE</version>
    <relativePath/>
  </parent>

  <properties>
    <maven.compiler.source>11</maven.compiler.source>
    <maven.compiler.target>11</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Variante B1 (Fix-Runde 1, Step 5 des Briefs): erste Stufe des minimalen
         Override-Sets, einzeln zugeschaltet, s. Gate E in spike-results.md.
         ABWEICHUNG vom Brief-Wert 2.21.0 (unrelated-to-the-version-question-Fall,
         s. Aufgabenstellung Punkt 5): com.fasterxml.jackson.core:jackson-annotations
         hat auf Maven Central KEIN 2.21.0-Release, nur "2.21" (ohne Patch-Ziffer),
         waehrend jackson-core/jackson-databind nur als "2.21.0" existieren (verifiziert
         per `mvn dependency:get` fuer alle drei Artefakte an beiden Versionsstrings).
         Boot 1.3.5 wendet EINE `jackson.version`-Property einheitlich auf core,
         databind UND annotations an (spring-boot-dependencies-1.3.5.RELEASE.pom,
         Zeilen 524-536), also ein Wert, der alle drei gleichzeitig aufloest, existiert
         in der 2.21-Linie nicht. 2.19.4 ist die naechstniedrigere Version, unter der
         jackson-core, jackson-databind UND jackson-annotations alle unter demselben
         Versionsstring aufloesen (verifiziert per `mvn dependency:get` fuer alle drei);
         >= 2.10, enthaelt also JsonFactoryBuilder/StreamWriteFeature/StreamReadFeature. -->
    <jackson.version>2.19.4</jackson.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.eclipse.rdf4j</groupId>
      <artifactId>rdf4j-runtime</artifactId>
      <version>5.3.1</version>
      <type>pom</type>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.2.0</version>
        <configuration>
          <mainClass>spike.Rdf4j5Boot13Check</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
