<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns="http://maven.apache.org/POM/4.0.0"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <artifactId>ajan-parent</artifactId>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <artifactId>maven-checkstyle-plugin</artifactId>
          <dependencies>
            <dependency>
              <artifactId>build-resources</artifactId>
              <groupId>${project.groupId}</groupId>
              <version>${project.version}</version>
            </dependency>
          </dependencies>
          <executions>
            <execution>
              <configuration>
                <configLocation>build-configuration/checkstyle-java-ruleset.xml</configLocation>
                <consoleOutput>true</consoleOutput>
                <encoding>UTF-8</encoding>
                <failsOnError>false</failsOnError>
                <includeTestSourceDirectory>true</includeTestSourceDirectory>
                <skip>true</skip>
              </configuration>
              <goals>
                <goal>check</goal>
              </goals>
              <id>validate</id>
              <phase>validate</phase>
            </execution>
          </executions>
          <groupId>org.apache.maven.plugins</groupId>
          <version>2.17</version>
        </plugin>
        <plugin>
          <artifactId>maven-pmd-plugin</artifactId>
          <configuration>
            <failOnViolation>true</failOnViolation>
            <ignoreLiterals>false</ignoreLiterals>
            <includeTests>true</includeTests>
            <linkXRef>false</linkXRef>
            <minimumTokens>54</minimumTokens>
            <rulesets>
              <ruleset>build-configuration/pmd-java-ruleset.xml</ruleset>
            </rulesets>
            <!-- PMD language level = compiler release; the plugin default ${maven.compiler.source} is unset here, PMD would fall back to its newest Java version -->
            <targetJdk>${maven.compiler.release}</targetJdk>
            <verbose>true</verbose>
          </configuration>
          <dependencies>
            <dependency>
              <artifactId>build-resources</artifactId>
              <groupId>${project.groupId}</groupId>
              <version>${project.version}</version>
            </dependency>
          </dependencies>
          <executions>
            <execution>
              <goals>
                <goal>check</goal>
              </goals>
              <id>validate-pmd</id>
              <!-- PMD 7 resolves types from the compiled main and test classes: checking before compilation (validate) gives false positives in clean builds -->
              <phase>process-test-classes</phase>
            </execution>
            <execution>
              <goals>
                <goal>cpd-check</goal>
              </goals>
              <id>validate-cpd</id>
              <phase>process-test-classes</phase>
            </execution>
          </executions>
          <groupId>org.apache.maven.plugins</groupId>
          <version>3.28.0</version>
        </plugin>
        <plugin>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <annotationProcessorPaths>
              <path>
                <artifactId>lombok</artifactId>
                <groupId>org.projectlombok</groupId>
                <version>${lombok.version}</version>
              </path>
            </annotationProcessorPaths>
            <release>${maven.compiler.release}</release>
          </configuration>
          <groupId>org.apache.maven.plugins</groupId>
          <version>3.13.0</version>
        </plugin>
        <plugin>
          <artifactId>maven-jar-plugin</artifactId>
          <configuration>
            <archive>
              <manifest>
                <addClasspath>true</addClasspath>
                <mainClass>${mainClass}</mainClass>
              </manifest>
            </archive>
          </configuration>
          <groupId>org.apache.maven.plugins</groupId>
          <version>3.4.2</version>
        </plugin>
        <plugin>
          <artifactId>maven-surefire-plugin</artifactId>
          <groupId>org.apache.maven.plugins</groupId>
          <version>3.5.2</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
  <dependencyManagement>
    <dependencies>
      <!-- Mockito 5 (inline mock maker, JDK 21); = mockito.version von spring-boot-dependencies 4.1.2. -->
      <dependency>
        <artifactId>mockito-core</artifactId>
        <groupId>org.mockito</groupId>
        <scope>test</scope>
        <version>5.23.0</version>
      </dependency>
      <dependency>
        <artifactId>lombok</artifactId>
        <groupId>org.projectlombok</groupId>
        <version>${lombok.version}</version>
      </dependency>
      <!-- Jackson 2 bleibt Produkt- und RESTEasy-Jackson-Linie (Etappe 4, Entscheidung 2);
           2.21.7 = jackson-2-bom.version von spring-boot-dependencies 4.1.2. -->
      <dependency>
        <artifactId>jackson-bom</artifactId>
        <groupId>com.fasterxml.jackson</groupId>
        <scope>import</scope>
        <type>pom</type>
        <version>2.21.7</version>
      </dependency>
      <!-- Jakarta REST 3.1 = die Version, gegen die RESTEasy 6.2 gebaut ist (W5). -->
      <dependency>
        <artifactId>jakarta.ws.rs-api</artifactId>
        <groupId>jakarta.ws.rs</groupId>
        <version>3.1.0</version>
      </dependency>
      <!-- Nur fuer MOSIMPlugin: @javax.annotation.Generated in Thrift-generiertem Code
           (Source-Retention, Compile-Zeit-Bedarf; W9). -->
      <dependency>
        <artifactId>javax.annotation-api</artifactId>
        <groupId>javax.annotation</groupId>
        <version>1.3.2</version>
      </dependency>
      <dependency>
        <artifactId>rdf4j-runtime</artifactId>
        <groupId>org.eclipse.rdf4j</groupId>
        <version>${org.eclipse.rdf4j.version}</version>
        <!--<scope></scope>-->
      </dependency>
      <dependency>
        <artifactId>testng</artifactId>
        <groupId>org.testng</groupId>
        <scope>test</scope>
        <version>7.10.2</version>
      </dependency>
      <dependency>
        <artifactId>hamcrest</artifactId>
        <groupId>org.hamcrest</groupId>
        <scope>test</scope>
        <version>3.0</version>
      </dependency>
      <dependency>
        <artifactId>opencsv</artifactId>
        <groupId>com.opencsv</groupId>
        <version>${opencsv.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <groupId>de.dfki.asr.ajan</groupId>
  <modelVersion>4.0.0</modelVersion>

  <modules>
    <module>build-resources</module>
    <module>rdfbeans</module>
    <module>behaviour</module>
    <module>functions</module>
    <module>common</module>
    <module>triplestore</module>
    <module>executionservice</module>
    <module>pluginsystem</module>
  </modules>
  <name>Ajan Parent Project</name>

  <packaging>pom</packaging>

  <properties>
    <lombok.version>1.18.48</lombok.version>
    <maven.compiler.release>21</maven.compiler.release>
    <org.eclipse.rdf4j.version>5.3.1</org.eclipse.rdf4j.version>
    <opencsv.version>5.12.0</opencsv.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <version>0.1</version>
</project>
