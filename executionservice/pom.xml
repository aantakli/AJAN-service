<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns="http://maven.apache.org/POM/4.0.0"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <artifactId>executionservice</artifactId>
  <build>
    <plugins>
      <plugin>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <!-- target/executionservice-0.1.jar bleibt das ausfuehrbare Fat-JAR (Docker,
               startAJAN.sh, e2e). Ab Boot 1.4 liegen dessen Klassen aber unter
               BOOT-INF/classes - die Plugins (MOSIM, MQTT) kompilieren gegen executionservice
               und braeuchten das klassische Layout. attach=false macht das unveraenderte
               Original-JAR zum Maven-Hauptartefakt (Reaktor + ~/.m2). -->
          <attach>false</attach>
        </configuration>
        <groupId>org.springframework.boot</groupId>
      </plugin>
      <!-- Third-party license report; not bound to the build (this module has the Spring Boot parent and
           does not inherit the root pluginManagement). Same settings as root pom, see README. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>license-maven-plugin</artifactId>
        <version>2.7.1</version>
        <configuration>
          <outputDirectory>${project.basedir}</outputDirectory>
          <thirdPartyFilename>THIRDPARTYLICENSE_${project.artifactId}.txt</thirdPartyFilename>
          <sortArtifactByName>true</sortArtifactByName>
          <useMissingFile>false</useMissingFile>
          <failOnMissing>false</failOnMissing>
          <excludedScopes>provided,test</excludedScopes>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-pmd-plugin</artifactId>
        <configuration>
          <failOnViolation>true</failOnViolation>
          <ignoreLiterals>false</ignoreLiterals>
          <includeTests>true</includeTests>
          <linkXRef>false</linkXRef>
          <minimumTokens>54</minimumTokens>
          <rulesets>
            <ruleset>build-configuration/pmd-java-ruleset.xml</ruleset>
          </rulesets>
          <!-- PMD language level = compiler release; the plugin default ${maven.compiler.source} is unset here, PMD would fall back to its newest Java version -->
          <targetJdk>${maven.compiler.release}</targetJdk>
          <verbose>true</verbose>
        </configuration>
        <dependencies>
          <dependency>
            <artifactId>build-resources</artifactId>
            <groupId>${project.groupId}</groupId>
            <version>${project.version}</version>
          </dependency>
        </dependencies>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
            <id>validate-pmd</id>
            <!-- PMD 7 resolves types from the compiled main and test classes: checking before compilation (validate) gives false positives in clean builds -->
            <phase>process-test-classes</phase>
          </execution>
          <execution>
            <goals>
              <goal>cpd-check</goal>
            </goals>
            <id>validate-cpd</id>
            <phase>process-test-classes</phase>
          </execution>
        </executions>
        <groupId>org.apache.maven.plugins</groupId>
        <version>3.28.0</version>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludes>
            <!-- Braucht einen laufenden Triplestore (8090); das Integrationsverhalten ist ueber die E2E-Tests abgedeckt. -->
            <exclude>**/BeliefUpdateStallTest.java</exclude>
          </excludes>
        </configuration>
        <groupId>org.apache.maven.plugins</groupId>
        <version>3.5.2</version>
      </plugin>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>${java.version}</release>
          <annotationProcessorPaths>
            <path>
              <artifactId>lombok</artifactId>
              <groupId>org.projectlombok</groupId>
              <version>${lombok.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
        <groupId>org.apache.maven.plugins</groupId>
      </plugin>
    </plugins>
  </build>
  <dependencies>
    <dependency>
      <artifactId>common</artifactId>
      <groupId>de.dfki.asr.ajan</groupId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <artifactId>behaviour</artifactId>
      <groupId>de.dfki.asr.ajan</groupId>
      <version>${project.version}</version>
    </dependency>
    <!-- Der RESTEasy-Starter schliesst spring-boot-starter-tomcat aus (W3). -->
    <dependency>
      <artifactId>spring-boot-starter-tomcat</artifactId>
      <groupId>org.springframework.boot</groupId>
    </dependency>
    <dependency>
      <artifactId>resteasy-servlet-spring-boot-starter</artifactId>
      <groupId>org.jboss.resteasy</groupId>
      <version>6.3.0.Final</version>
    </dependency>
    <!-- Spring MVC bleibt neben RESTEasy: CorsFilter, Swagger-UI-Resource-Handler, Redirect auf / -->
    <dependency>
      <artifactId>spring-boot-starter-webmvc</artifactId>
      <groupId>org.springframework.boot</groupId>
    </dependency>
    <dependency>
      <artifactId>spring-boot-starter-test</artifactId>
      <groupId>org.springframework.boot</groupId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <artifactId>libthrift</artifactId>
      <groupId>org.apache.thrift</groupId>
      <version>0.15.0</version>
    </dependency>
    <dependency>
      <artifactId>gdx-ai</artifactId>
      <groupId>com.badlogicgames.gdx</groupId>
      <version>1.8.2</version>
    </dependency>
    <dependency>
      <artifactId>swagger-jaxrs2-jakarta</artifactId>
      <groupId>io.swagger.core.v3</groupId>
      <version>2.2.55</version>
    </dependency>
    <dependency>
      <artifactId>swagger-ui</artifactId>
      <groupId>org.webjars</groupId>
      <version>5.34.0</version>
    </dependency>
    <!-- Surefire nutzt wegen junit-jupiter (spring-boot-starter-test) den JUnit-Platform-Provider; die TestNG-Tests
         wuerden dort nicht gefunden. Die testng-engine laesst TestNG und JUnit Jupiter zusammen auf der Platform laufen. -->
    <dependency>
      <artifactId>testng-engine</artifactId>
      <groupId>org.junit.support</groupId>
      <scope>test</scope>
      <version>1.1.0</version>
    </dependency>
    <dependency>
      <artifactId>testng</artifactId>
      <groupId>org.testng</groupId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <artifactId>hamcrest</artifactId>
      <groupId>org.hamcrest</groupId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <artifactId>oro</artifactId>
      <groupId>oro</groupId>
      <version>2.0.8</version>
    </dependency>
    <dependency>
      <artifactId>xercesImpl</artifactId>
      <groupId>xerces</groupId>
      <version>2.12.1</version>
    </dependency>
    <dependency>
      <artifactId>opencsv</artifactId>
      <groupId>com.opencsv</groupId>
    </dependency>
    <dependency>
      <artifactId>jep</artifactId>
      <groupId>black.ninia</groupId>
      <version>4.2.2</version>
    </dependency>
    <dependency>
      <artifactId>zip4j</artifactId>
      <groupId>net.lingala.zip4j</groupId>
      <version>2.11.5</version>
    </dependency>
  </dependencies>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <artifactId>ajan-parent</artifactId>
        <groupId>de.dfki.asr.ajan</groupId>
        <scope>import</scope>
        <type>pom</type>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <groupId>de.dfki.asr.ajan</groupId>

  <modelVersion>4.0.0</modelVersion>

  <packaging>jar</packaging>

  <parent>
    <artifactId>spring-boot-starter-parent</artifactId>
    <groupId>org.springframework.boot</groupId>
    <relativePath></relativePath>
    <version>4.1.2</version>
  </parent>

  <properties>
    <!-- Insel (Boot-Parent): erbt nicht vom ajan-parent. Java-Release hier ueber java.version
         (Boot-Konvention), Wert = maven.compiler.release im Root-POM. lombok.version kommt
         von spring-boot-dependencies 4.1.2 (1.18.48). Drift: java.version muss mit
         maven.compiler.release im Root-POM uebereinstimmen (kein Build-Check). -->
    <java.version>25</java.version>
    <!-- Boot 4.1.2 verwaltet jakarta.ws.rs-api 4.0.0; RESTEasy 6.2 ist gegen 3.1 gebaut (W5). -->
    <jakarta-ws-rs.version>3.1.0</jakarta-ws-rs.version>
    <netbeans.hint.license>licenseheader</netbeans.hint.license>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <reporting>
    <plugins>
      <plugin>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <configuration>
          <configLocation>config/sun_checks.xml</configLocation>
          <skip>true</skip>
        </configuration>
        <groupId>org.apache.maven.plugins</groupId>
      </plugin>
    </plugins>
  </reporting>
  <version>0.1</version>
</project>
